# CODFISH — IBM Quantum hardware credentials
# Copy this file to `backend/.env` and fill in the real values there.
# `backend/.env` is already covered by .gitignore — never commit it.
#
# Qiskit Fall Fest 2026: paste the shared PINQ² API token the organizers
# give you privately into IBM_QUANTUM_TOKEN below. No personal IBM Quantum
# account is needed for the event.

# Turns on IBM hardware mode for ZNE, the DD lab, the twirl lab and the
# readout-mitigation lab. Leave as false/unset to stay in simulator-only mode.
IBM_ENABLE=true

# The shared PINQ² token (or your own IBM Quantum API key).
IBM_QUANTUM_TOKEN=PASTE_PINQ2_TOKEN_HERE

# Optional: only needed if the token can reach several instances and you
# want to pin one. PINQ² organizers will tell you if you need this (a CRN).
IBM_QUANTUM_INSTANCE=

# A backend name your token/instance can actually see, e.g. ibm_quebec.
# Run backend/verify_ibm_connection.py after setting the token above to
# list what you can access, then paste one of the printed names here.
IBM_BACKEND=
